<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mfi_lending_command_list" model="ir.ui.view">
        <field name="name">mfi.lending.command.list</field>
        <field name="model">mfi.lending.command</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'refused'"
                  decoration-warning="state in ('pending', 'unavailable')">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="lending_ref" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="http_status" optional="show"/>
                <field name="code"/>
                <field name="trace_id" optional="show"/>
                <field name="attempts" optional="hide"/>
                <field name="idempotency_key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mfi_lending_command_search" model="ir.ui.view">
        <field name="name">mfi.lending.command.search</field>
        <field name="model">mfi.lending.command</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation"/>
                <field name="lending_ref"/>
                <field name="trace_id"/>
                <field name="user_id"/>
                <filter name="problems" string="Refused or unavailable" domain="[('state', 'in', ('refused', 'unavailable', 'pending'))]"/>
                <group>
                    <filter name="by_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="by_state" string="Outcome" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mfi_lending_command" model="ir.actions.act_window">
        <field name="name">Lending service commands</field>
        <field name="res_model">mfi.lending.command</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Every command Odoo sent to the lending service, with its outcome and reference. No personal data is kept here.</p>
        </field>
    </record>
</odoo>
