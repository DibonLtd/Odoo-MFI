<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mfi" model="ir.module.category">
        <field name="name">Microfinance</field>
        <field name="sequence">40</field>
    </record>

    <!-- Every role reads everything in Microfinance; writes are per role. -->
    <record id="group_mfi_user" model="res.groups">
        <field name="name">Microfinance: read</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- One privilege per role, so one person can hold several roles. The roles that
         onboard or blacklist clients also get Contact Creation, which Odoo requires
         to create or change a contact. -->
    <record id="privilege_mfi_loan_officer" model="res.groups.privilege">
        <field name="name">Loan Officer</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_loan_officer" model="res.groups">
        <field name="name">Loan Officer</field>
        <field name="privilege_id" ref="privilege_mfi_loan_officer"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="privilege_mfi_credit_manager" model="res.groups.privilege">
        <field name="name">Credit Manager</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_credit_manager" model="res.groups">
        <field name="name">Credit Manager</field>
        <field name="privilege_id" ref="privilege_mfi_credit_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="privilege_mfi_head_office" model="res.groups.privilege">
        <field name="name">Head Office</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_head_office" model="res.groups">
        <field name="name">Head Office</field>
        <field name="privilege_id" ref="privilege_mfi_head_office"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="privilege_mfi_ceo" model="res.groups.privilege">
        <field name="name">Chief Executive Officer</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_ceo" model="res.groups">
        <field name="name">Chief Executive Officer</field>
        <field name="privilege_id" ref="privilege_mfi_ceo"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="privilege_mfi_finance" model="res.groups.privilege">
        <field name="name">Finance / Cashier</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_finance" model="res.groups">
        <field name="name">Finance / Cashier</field>
        <field name="privilege_id" ref="privilege_mfi_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user'))]"/>
    </record>

    <record id="privilege_mfi_collections" model="res.groups.privilege">
        <field name="name">Collections Officer</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_collections" model="res.groups">
        <field name="name">Collections Officer</field>
        <field name="privilege_id" ref="privilege_mfi_collections"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user'))]"/>
    </record>

    <record id="privilege_mfi_auditor" model="res.groups.privilege">
        <field name="name">Auditor</field>
        <field name="sequence">70</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="privilege_mfi_auditor"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user'))]"/>
    </record>

    <record id="privilege_mfi_admin" model="res.groups.privilege">
        <field name="name">Microfinance Administrator</field>
        <field name="sequence">80</field>
        <field name="category_id" ref="module_category_mfi"/>
    </record>
    <record id="group_mfi_admin" model="res.groups">
        <field name="name">Super Admin</field>
        <field name="privilege_id" ref="privilege_mfi_admin"/>
        <field name="implied_ids" eval="[(4, ref('group_mfi_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
