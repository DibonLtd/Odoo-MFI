<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Numbers in the portal's format: RC-L-000037, RC-C-00012 -->
        <record id="seq_mfi_loan" model="ir.sequence">
            <field name="name">Loan S/N</field>
            <field name="code">mfi.loan</field>
            <field name="prefix">RC-L-</field>
            <field name="padding">6</field>
        </record>
        <record id="seq_mfi_client" model="ir.sequence">
            <field name="name">Client no.</field>
            <field name="code">mfi.client</field>
            <field name="prefix">RC-C-</field>
            <field name="padding">5</field>
        </record>

        <!-- Products, from the Roan Capital portal's settings -->
        <record id="product_chattels" model="mfi.product">
            <field name="name">Chattels Mortgage Loan</field>
            <field name="category">chattels</field>
            <field name="sequence">10</field>
        </record>
        <record id="product_logbook" model="mfi.product">
            <field name="name">Logbook Loan</field>
            <field name="category">logbook</field>
            <field name="sequence">20</field>
        </record>
        <record id="product_title_deed" model="mfi.product">
            <field name="name">Title Deed Loan</field>
            <field name="category">title_deed</field>
            <field name="sequence">30</field>
        </record>

        <!-- Fees, from the portal's settings -->
        <record id="fee_membership" model="mfi.fee">
            <field name="name">Membership fee (one-time, non-refundable)</field>
            <field name="code">membership</field>
            <field name="sequence">10</field>
            <field name="amount">100</field>
            <field name="first_loan_only" eval="True"/>
            <field name="upfront_on_first_loan" eval="True"/>
        </record>
        <record id="fee_application_small" model="mfi.fee">
            <field name="name">Loan application fee</field>
            <field name="code">application</field>
            <field name="sequence">20</field>
            <field name="amount">500</field>
            <field name="min_principal">3000</field>
            <field name="max_principal">19999</field>
            <field name="upfront_on_first_loan" eval="True"/>
        </record>
        <record id="fee_application_large" model="mfi.fee">
            <field name="name">Loan application fee</field>
            <field name="code">application</field>
            <field name="sequence">20</field>
            <field name="amount">1000</field>
            <field name="min_principal">20000</field>
            <field name="max_principal">100000</field>
            <field name="upfront_on_first_loan" eval="True"/>
        </record>
        <record id="fee_lif" model="mfi.fee">
            <field name="name">LIF</field>
            <field name="code">lif</field>
            <field name="sequence">30</field>
            <field name="amount">200</field>
        </record>
        <record id="fee_remittance" model="mfi.fee">
            <field name="name">Remittance</field>
            <field name="code">remittance</field>
            <field name="sequence">40</field>
            <field name="amount">120</field>
        </record>
        <record id="fee_chattels_small" model="mfi.fee">
            <field name="name">Chattels mortgage</field>
            <field name="code">chattels</field>
            <field name="sequence">50</field>
            <field name="amount">500</field>
            <field name="min_principal">5001</field>
            <field name="max_principal">9999</field>
            <field name="product_category">chattels</field>
        </record>
        <record id="fee_chattels_large" model="mfi.fee">
            <field name="name">Chattels mortgage</field>
            <field name="code">chattels</field>
            <field name="sequence">50</field>
            <field name="amount">1000</field>
            <field name="min_principal">10000</field>
            <field name="max_principal">100000</field>
            <field name="product_category">chattels</field>
        </record>

        <record id="ir_cron_mfi_loan_health" model="ir.cron">
            <field name="name">Microfinance: charge default interest and refresh loan health</field>
            <field name="model_id" ref="model_mfi_loan"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- The portal's session limits: sign out after 60 idle minutes and after 10 hours.
             They apply to every user of the database; change or switch off in Settings. -->
        <record id="param_session_idle_minutes" model="ir.config_parameter">
            <field name="key">mfi_loan.session_idle_minutes</field>
            <field name="value">60</field>
        </record>
        <record id="param_session_max_hours" model="ir.config_parameter">
            <field name="key">mfi_loan.session_max_hours</field>
            <field name="value">10</field>
        </record>
    </data>
</odoo>
