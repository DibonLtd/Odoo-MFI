<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Repayments are Odoo's own payments (DECISIONS D-017): these are lists of them. -->
    <record id="mfi_payment_view_list" model="ir.ui.view">
        <field name="name">account.payment.list.mfi</field>
        <field name="model">account.payment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Repayments" create="0" decoration-muted="state == 'canceled'"
                  decoration-warning="not is_reconciled and state != 'canceled'">
                <field name="date"/>
                <field name="mfi_loan_id"/>
                <field name="partner_id"/>
                <field name="journal_id" string="Method"/>
                <field name="memo" string="Reference"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="is_reconciled" string="Applied" optional="show"/>
                <field name="state" widget="badge" decoration-success="state in ('paid', 'reconciled')"/>
                <field name="create_uid" string="Recorded by" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mfi_payment_view_form" model="ir.ui.view">
        <field name="name">account.payment.form.mfi</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_mfi_payment_match)d" type="action" string="Apply to a loan" class="oe_highlight"
                        invisible="payment_type != 'inbound' or is_reconciled or state not in ('paid', 'reconciled')"
                        groups="mfi_loan.group_mfi_admin,mfi_loan.group_mfi_head_office,mfi_loan.group_mfi_credit_manager,mfi_loan.group_mfi_finance,mfi_loan.group_mfi_collections,mfi_loan.group_mfi_loan_officer"/>
                <button name="%(action_mfi_payment_reverse)d" type="action" string="Reverse repayment"
                        invisible="not mfi_loan_id or state == 'canceled' or payment_type != 'inbound'"
                        groups="mfi_loan.group_mfi_admin,mfi_loan.group_mfi_ceo,mfi_loan.group_mfi_head_office,mfi_loan.group_mfi_finance"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mfi_loan_id" invisible="not mfi_loan_id"/>
            </xpath>
        </field>
    </record>

    <record id="mfi_payment_view_search" model="ir.ui.view">
        <field name="name">account.payment.search.mfi</field>
        <field name="model">account.payment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="memo" string="Reference"/>
                <field name="mfi_loan_id"/>
                <field name="partner_id"/>
                <filter name="unmatched" string="Not applied" domain="[('is_reconciled', '=', False), ('state', 'in', ('paid', 'reconciled'))]"/>
                <filter name="applied" string="Applied" domain="[('is_reconciled', '=', True)]"/>
                <filter name="reversed" string="Reversed" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group>
                    <filter name="group_method" string="Method" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mfi_payment" model="ir.actions.act_window">
        <field name="name">Repayments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form,graph</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('partner_id.is_mfi_client', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="mfi_payment_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('mfi_payment_view_list')})]"/>
    </record>

    <record id="action_mfi_payment_unmatched" model="ir.actions.act_window">
        <field name="name">Unmatched payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{'search_default_unmatched': 1, 'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
        <field name="search_view_id" ref="mfi_payment_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('mfi_payment_view_list')})]"/>
        <field name="help" type="html">
            <p>Money received that is not yet applied to a loan: an M-Pesa account number that matched nothing, for example.
            Open it and press <b>Apply to a loan</b>. Bank and M-Pesa statements are reconciled in Accounting.</p>
        </field>
    </record>
</odoo>
