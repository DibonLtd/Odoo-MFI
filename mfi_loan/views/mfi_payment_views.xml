<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mfi_payment_view_list" model="ir.ui.view">
        <field name="name">mfi.payment.list</field>
        <field name="model">mfi.payment</field>
        <field name="arch" type="xml">
            <list string="Repayments" decoration-muted="state == 'reversed'" decoration-warning="state == 'unmatched'">
                <field name="date"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="method"/>
                <field name="reference"/>
                <field name="lookup" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="to_penalty" optional="hide" sum="Total"/>
                <field name="to_installments" optional="hide" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'allocated'"
                       decoration-warning="state == 'unmatched'"/>
                <field name="create_uid" string="Recorded by" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mfi_payment_view_form" model="ir.ui.view">
        <field name="name">mfi.payment.form</field>
        <field name="model">mfi.payment</field>
        <field name="arch" type="xml">
            <form string="Repayment">
                <header>
                    <button name="%(action_mfi_payment_match)d" type="action" string="Match to a loan"
                            class="oe_highlight" invisible="not id or state != 'unmatched'"/>
                    <button name="%(action_mfi_payment_reverse)d" type="action" string="Reverse"
                            invisible="not id or state == 'reversed'"
                            groups="mfi_loan.group_mfi_admin,mfi_loan.group_mfi_ceo,mfi_loan.group_mfi_head_office,mfi_loan.group_mfi_finance"/>
                    <field name="state" widget="statusbar" statusbar_visible="unmatched,allocated"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="loan_id" options="{'no_create': True}" readonly="id"/>
                            <field name="lookup" invisible="loan_id" readonly="id"
                                   placeholder="Loan S/N, ID number or phone"/>
                            <field name="partner_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="id"/>
                            <field name="method" widget="radio" readonly="id"/>
                            <field name="reference" required="method != 'cash'" readonly="id"
                                   placeholder="M-Pesa / bank transaction reference"/>
                            <field name="payer_phone" readonly="id"/>
                            <field name="date" readonly="id"/>
                            <field name="note" readonly="id"/>
                        </group>
                        <group string="Applied" invisible="state != 'allocated'">
                            <field name="to_penalty"/>
                            <field name="to_installments"/>
                            <field name="overpayment"/>
                        </group>
                        <group string="Reversed" invisible="state != 'reversed'">
                            <field name="reversal_reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mfi_payment_view_search" model="ir.ui.view">
        <field name="name">mfi.payment.search</field>
        <field name="model">mfi.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="lookup"/>
                <field name="payer_phone"/>
                <filter name="unmatched" string="Unmatched" domain="[('state', '=', 'unmatched')]"/>
                <filter name="allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
                <filter name="reversed" string="Reversed" domain="[('state', '=', 'reversed')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group>
                    <filter name="group_method" string="Method" context="{'group_by': 'method'}"/>
                    <filter name="group_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mfi_payment" model="ir.actions.act_window">
        <field name="name">Repayments</field>
        <field name="res_model">mfi.payment</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <record id="action_mfi_payment_unmatched" model="ir.actions.act_window">
        <field name="name">Unmatched payments</field>
        <field name="res_model">mfi.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unmatched': 1}</field>
    </record>
</odoo>
