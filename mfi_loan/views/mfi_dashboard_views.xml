<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The live dashboard is a client action (static/src/dashboard): period picker,
        animated figures with trends, charts, and lists you can click into.
        Data: mfi.dashboard.mfi_dashboard_data().
    -->
    <record id="action_mfi_dashboard_live" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">mfi_loan.dashboard</field>
        <field name="path">microfinance-dashboard</field>
    </record>

    <!-- How it works: the presentation page shown before a live demo -->
    <record id="action_mfi_how_it_works" model="ir.actions.client">
        <field name="name">How it works</field>
        <field name="tag">mfi_loan.how_it_works</field>
        <field name="path">microfinance-how-it-works</field>
    </record>

    <!-- Kept for existing links and bookmarks: opens the live dashboard. -->
    <record id="action_mfi_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_mfi_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env["ir.actions.actions"]._for_xml_id("mfi_loan.action_mfi_dashboard_live")</field>
    </record>

    <!-- Charts behind the dashboard -->
    <record id="mfi_payment_view_graph" model="ir.ui.view">
        <field name="name">mfi.payment.graph</field>
        <field name="model">mfi.payment</field>
        <field name="arch" type="xml">
            <graph string="Collected" type="line">
                <field name="date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
