<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Collections on Odoo's own tools (DECISIONS D-017): contacts and promises are
         activities on the loan, instalments are the loan invoice's receivable lines. -->
    <record id="mfi_loan_view_list_collections" model="ir.ui.view">
        <field name="name">mfi.loan.list.collections</field>
        <field name="model">mfi.loan</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Late loans" create="0" default_order="days_past_due desc"
                  decoration-danger="health == 'overdue'" decoration-warning="health == 'arrears'">
                <header>
                    <button name="action_send_reminder_sms" type="object" string="Send reminder SMS"/>
                </header>
                <field name="partner_id"/>
                <field name="partner_phone_masked"/>
                <field name="guarantor_name" string="Guarantor" optional="show"/>
                <field name="guarantor_phone_masked" optional="show"/>
                <field name="name"/>
                <field name="days_past_due" string="Days late"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="arrears_amount" string="Arrears" sum="Total"/>
                <field name="outstanding" sum="Total"/>
                <field name="activity_ids" widget="list_activity" string="Next contact" optional="show"/>
                <field name="activity_date_deadline" string="Due" optional="show"/>
                <field name="health" widget="badge" decoration-warning="health == 'arrears'"
                       decoration-danger="health == 'overdue'"/>
                <button name="action_unlock_phone" type="object" string="Unlock" icon="lock_open"/>
                <button name="action_whatsapp_reminder" type="object" string="WhatsApp" icon="oi_whatsapp"/>
            </list>
        </field>
    </record>

    <record id="action_mfi_collections_late" model="ir.actions.act_window">
        <field name="name">Late loans</field>
        <field name="res_model">mfi.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'active'), ('health', 'in', ('arrears', 'overdue'))]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mfi_loan_view_list_collections')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mfi_loan_view_form')})]"/>
    </record>

    <!-- Promises to pay: activities of that type; overdue = broken -->
    <record id="action_mfi_collections_promises" model="ir.actions.act_window">
        <field name="name">Promises to pay</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'mfi.loan'), ('activity_type_id', '=', ref('mfi_loan.mail_activity_promise'))]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>A promise is an activity on the loan: open the loan, schedule a <b>Promise to pay</b> on the promised date.
            Mark it done when paid; one still open after its date was not kept.</p>
        </field>
    </record>

    <!-- Due today: the instalments (receivable lines of loan invoices) due today -->
    <record id="mfi_instalment_view_list_due" model="ir.ui.view">
        <field name="name">account.move.line.list.mfi.due</field>
        <field name="model">account.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Due today" create="0" edit="0" decoration-success="reconciled">
                <field name="partner_id"/>
                <field name="move_id" string="Loan invoice"/>
                <field name="date_maturity" string="Due"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="balance" string="Instalment" sum="Total"/>
                <field name="amount_residual" string="Still to pay" sum="Total"/>
                <field name="reconciled" string="Paid"/>
            </list>
        </field>
    </record>

    <record id="action_mfi_collections_due_today" model="ir.actions.act_window">
        <field name="name">Due today</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mfi_instalment_view_list_due"/>
        <field name="domain">[('date_maturity', '=', context_today().strftime('%Y-%m-%d')),
                              ('move_id.mfi_kind', '=', 'loan'), ('parent_state', '=', 'posted'),
                              ('account_id.account_type', '=', 'asset_receivable'),
                              ('move_id.mfi_loan_id.state', '=', 'active')]</field>
    </record>

    <record id="action_mfi_collections_collected" model="ir.actions.act_window">
        <field name="name">Collected</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('mfi_loan_id', '!=', False), ('state', '!=', 'canceled')]</field>
        <field name="context">{'search_default_this_month': 1, 'create': False}</field>
        <field name="search_view_id" ref="mfi_payment_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('mfi_payment_view_list')})]"/>
    </record>
</odoo>
