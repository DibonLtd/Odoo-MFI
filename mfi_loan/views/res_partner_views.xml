<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_mfi" model="ir.ui.view">
        <field name="name">res.partner.form.mfi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mfi_loans" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not is_mfi_client" groups="mfi_loan.group_mfi_user">
                    <field name="mfi_loan_count" widget="statinfo" string="Loans"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Microfinance" name="mfi" groups="mfi_loan.group_mfi_user">
                    <group>
                        <group>
                            <field name="is_mfi_client"/>
                            <field name="mfi_client_type" invisible="not is_mfi_client"/>
                            <field name="mfi_id_number" invisible="not is_mfi_client"/>
                        </group>
                        <group invisible="not is_mfi_client">
                            <field name="mfi_blacklisted"/>
                            <field name="mfi_blacklist_reason" invisible="not mfi_blacklisted"
                                   required="mfi_blacklisted"/>
                            <field name="mfi_documents_complete"/>
                            <field name="mfi_documents_missing" invisible="mfi_documents_complete"/>
                        </group>
                    </group>
                    <field name="mfi_document_ids" invisible="not is_mfi_client">
                        <list editable="bottom">
                            <field name="kind"/>
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="file_name" column_invisible="True"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_mfi_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_mfi_client', '=', True)]</field>
        <field name="context">{'default_is_mfi_client': True, 'default_mfi_client_type': 'individual'}</field>
    </record>
</odoo>
